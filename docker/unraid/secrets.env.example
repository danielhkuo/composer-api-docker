# Copy to /mnt/user/appdata/api-for-cursor/secrets.env then chmod 600 it.
# Container-side variable names, so no ${} interpolation is needed and the
# secrets never sit next to the compose file on the USB boot device.
CURSOR_API_KEY=
CURSOR_SDK_BRIDGE_TOKEN=
CURSOR_SDK_BRIDGE_TIMEOUT_MS=600000
CURSOR_SDK_BRIDGE_RUN_TIMEOUT_MS=600000
# Set this if anything beyond your own containers can reach the network.
LOCAL_API_TOKEN=
